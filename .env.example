APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# true: la API responde 503 a todo (modo mantenimiento). Tras cambiarlo: php artisan config:cache
MANTENIMIENTO=false
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=royal_backend
DB_USERNAME=root
DB_PASSWORD=

# Base transversal (marcas por dominio, logs de actividad) — mismo server/credenciales por
# defecto (ver DB_ADMIN_HOST/PORT/USERNAME/PASSWORD en config/database.php si cambia).
DB_ADMIN_DATABASE=admin_management

# Los módulos de administración transversal (marcas por dominio, bases de datos, logs por
# dominio, elegir la connection activa) solo responden a estos correos exactos, separados
# por coma (ver RestrictToAdminEmails).
ADMIN_MANAGEMENT_EMAILS=hernando.ramirez@royalschool.edu.co,angel.vargas@royalschool.edu.co,jhonier.duran@royalschool.edu.co

# Gestión Humana — correo(s), separados por coma, que reciben copia de cada solicitud
# nueva de Certificados/Trámites/Permisos y Licencias (ver config/gestionHumana.php).
GESTION_HUMANA_EMAIL_ROYAL=

# Permisos y Licencias — enrutamiento de correo por perfil/nivel del solicitante (ver
# PermisosLicenciasServices::destinatariosNotificacion).
ROYAL_DIRECCION_ADMINISTRATIVA_EMAIL=
ROYAL_ASISTENTE_DIRECCION_ADMINISTRATIVA_EMAIL=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Duración de la sesión (JWT) en minutos; sin definir = 480 (8 h). Ver config/jwt.php.
JWT_TTL=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# INSTITUCIONES — días de gracia y correo(s) de notificación ahora se editan desde el
# admin (módulo Instituciones), no acá — ver tabla configuracion_instituciones.

# UPLOADS — sin UPLOADS_DISK: `public` (public/storage) en local y Cloudinary con
# APP_ENV=production (ver config/filesystems.php). Defínela solo para forzar otro disco.
# Disco sami (public/upload del sami legado):
# UPLOADS_DISK=sami
# SAMI_UPLOAD_ROOT=/home/royal/sami_royal/public/upload
# SAMI_UPLOAD_URL=https://sami.royalschool.edu.co/public/upload
# En Cloudinary (migrados y nuevos en <prefijo>/<ruta en BD>; ver CloudinaryUploadsAdapter):
# UPLOADS_DISK=cloudinary
# CLOUDINARY_UPLOADS_PREFIJO=royal

# MIGRACIÓN A CLOUDINARY — token del POST /api/migracion/cloudinary (script_liberacion).
# Vacío = endpoint apagado (404). Generar uno largo y borrarlo al terminar la migración.
MIGRACION_API_TOKEN=
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Terminales Hikvision (control de acceso, DS-K1T321MFWX-B) de Royal.
# OBSOLETO desde 2026-10-26: las terminales se administran en "Terminales de acceso"
# (tabla hikvision_dispositivos). Estas variables solo las lee la migración
# 2026_10_26_100000_add_conexion_to_hikvision_dispositivos para importarlas; luego se borran.

# Royal (connection 'mysql')
HIKVISION_PROTOCOL=http
HIKVISION_HOST=
HIKVISION_PORT=8000
HIKVISION_USERNAME=
HIKVISION_PASSWORD=
# Terminales adicionales (fan-out), mismas credenciales de arriba.
# Formato: "Nombre@host[:port],Nombre2@host2[:port2]" - nombre y puerto
# opcionales; vacío = un solo dispositivo.
HIKVISION_HOSTS=

HIKVISION_VERIFY_SSL=false

# WhatsApp Business (Meta Cloud API) - ver docs/whatsapp-llegadas-tarde.md para el
# checklist de configuración en Meta Business Manager. Mientras WHATSAPP_ENABLED=false
# no se llama a la API, solo se deja constancia en el log.
WHATSAPP_ENABLED=false
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_LANG=es
WHATSAPP_TEMPLATE_NORMAL=llegada_tarde_normal
WHATSAPP_TEMPLATE_ADVERTENCIA=llegada_tarde_advertencia
WHATSAPP_TEMPLATE_LIMITE=llegada_tarde_limite

# Solo con APP_ENV=local: false salta el codigo de verificacion de equipo en el login.
AUTH_DEVICE_OTP=false

# Marcación con QR de portería: CIDRs desde donde se permite marcar, separados por coma (vacío = sin restricción). Ej: 190.0.0.0/24,10.0.0.0/8
ASISTENCIA_QR_REDES=
