    "id": 1,
    "id_inscripcion": 1,
    "notas": "Actualización: presenta dificultades en el trazo",
    "updated_by": 1
}

### 8. ELIMINAR
DELETE http://localhost:8000/api/historia-clinica/desarrollo-psicomotor
Content-Type: application/json
Accept: application/json

{
    "id": 1
}

