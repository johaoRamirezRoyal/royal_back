### ============================================
### OBSERVACIONES Y FIRMAS
### ============================================

### 25. VER por inscripción
GET http://localhost:8000/api/historia-clinica/observaciones-firmas?id_inscripcion=1

### 26. CREAR / ACTUALIZAR
POST http://localhost:8000/api/historia-clinica/observaciones-firmas
Content-Type: application/json
Accept: application/json

{
    "id_inscripcion": 1,
    "observaciones": "Se recomienda seguimiento psicológico mensual. El paciente muestra avances en su desarrollo cognitivo.",
    "updated_by": 1
}

### 27. ACTUALIZAR por id
PUT http://localhost:8000/api/historia-clinica/observaciones-firmas
Content-Type: application/json
Accept: application/json

{
    "id": 1,
    "id_inscripcion": 1,
    "observaciones": "Actualización: paciente en buen estado, se mantiene seguimiento.",
    "updated_by": 1
}

### 28. SUBIR FIRMA PADRE (multipart/form-data)
POST http://localhost:8000/api/historia-clinica/observaciones-firmas/1/firma/firma_padre
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="firma"; filename="firma_padre.png"
Content-Type: image/png

< ./firma_padre.png
--WebAppBoundary--

### 29. SUBIR FIRMA MADRE
POST http://localhost:8000/api/historia-clinica/observaciones-firmas/1/firma/firma_madre
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="firma"; filename="firma_madre.png"
Content-Type: image/png

< ./firma_madre.png
--WebAppBoundary--

### 30. SUBIR FIRMA PSICÓLOGA
POST http://localhost:8000/api/historia-clinica/observaciones-firmas/1/firma/firma_psicologa
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="firma"; filename="firma_psicologa.png"
Content-Type: image/png

< ./firma_psicologa.png
--WebAppBoundary--

### 31. ELIMINAR (elimina las firmas de Cloudinary también)
DELETE http://localhost:8000/api/historia-clinica/observaciones-firmas
Content-Type: application/json
Accept: application/json

{
    "id": 1
}

