Content-Type: application/json
Accept: application/json

{
    "id_inscripcion": 1,
    "sostenimiento_cabeza": "A los 2 meses",
    "sentarse_solo": "A los 6 meses",
    "equilibrio": "Adecuado",
    "gateo": "A los 8 meses",
    "caminar": "A los 12 meses",
    "seguimiento_ocular": "Presente",
    "agarre_pinza": "Adecuado",
    "abotonarse": "5 años",
    "recorte": "Adecuado para su edad",
    "trazo": "Buena grafomotricidad",
    "lateralidad": "Diestro",
    "notas": "Sin observaciones relevantes",
    "updated_by": 1
}

### 7. ACTUALIZAR por id
