# Fires royal-back-scheduler.service every minute, replacing the classic
# `* * * * * php artisan schedule:run` crontab entry.
#
# Install: see deploy/royal-back-scheduler.service

[Unit]
Description=Royal Backend - Run Laravel scheduler every minute

[Timer]
OnCalendar=*-*-* *:*:00
AccuracySec=1s
Persistent=true
Unit=royal-back-scheduler.service

[Install]
WantedBy=timers.target
